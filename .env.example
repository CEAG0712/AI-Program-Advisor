# Anticipated configuration only; the D1.1 harness does not load this file.
# Replace placeholders only in a local, Git-ignored file in a later increment.
NODE_ENV=<development-environment>
PORT=<local-api-port>
DATABASE_URL=<postgresql-connection-string>
DEMO_AUTH_TOKEN=<local-demo-token>
DEMO_TENANT_ID=<server-configured-demo-tenant>
# Trusted tenant identity must be established server-side from authentication.
# Never trust tenant identity supplied by a request or model as authorization.
# No OpenAI or AWS credentials are required for D1.1.
